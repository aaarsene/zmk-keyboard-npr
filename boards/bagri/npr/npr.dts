
/dts-v1/;
#include "npr.dtsi"
#include "npr-pinctrl.dtsi"
#include "npr-layouts.dtsi"

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };

    matrix_transform_full: matrix_transform_full {
        compatible = "zmk,matrix-transform";

        rows = <7>;
        columns = <4>;
        
        map = <
                    RC(6,0) RC(6,1) RC(6,2)
            RC(0,0) RC(0,1) RC(0,2) RC(0,3)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3)
            RC(4,0) RC(4,1) RC(4,2) RC(4,3)
            RC(5,0) RC(5,1) RC(5,2) RC(5,3)
        >;
    };

    matrix_transform_standard: matrix_transform_standard {
        compatible = "zmk,matrix-transform";

        rows = <7>;
        columns = <4>;
        
        map = <
                    RC(6,0) RC(6,1) RC(6,2)
            RC(0,0) RC(0,1) RC(0,2) RC(0,3)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3)
            RC(3,0) RC(3,1) RC(3,2) 
            RC(4,0) RC(4,1) RC(4,2) RC(4,3)
            RC(5,0)         RC(5,2)
        >;
    };

    matrix_transform_mirror: matrix_transform_mirror {
        compatible = "zmk,matrix-transform";

        rows = <7>;
        columns = <4>;
        
        map = <
                    RC(6,0) RC(6,1) RC(6,2)
            RC(0,0) RC(0,1) RC(0,2) RC(0,3)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3)
                    RC(3,1) RC(3,2) RC(3,3)
            RC(4,0) RC(4,1) RC(4,2) RC(4,3)
                    RC(5,1)         RC(5,3)
        >;
    };

    kscan0: kscan_composite {
        compatible = "zmk,kscan-composite";
        wakeup-source;

        rows = <7>;
        columns = <4>;

        // Include the direct GPIO driver...
        matrix {
            kscan = <&kscan_matrix>;
        };
        rotary {
            kscan = <&kscan_rotary_switch>;
            row-offset = <6>;
        };
    };

    kscan_matrix: kscan_matrix {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;

        diode-direction = "col2row";

        col-gpios
            = <&gpio1 9  GPIO_ACTIVE_HIGH>
            , <&gpio0 5  GPIO_ACTIVE_HIGH>
            , <&gpio0 9  GPIO_ACTIVE_HIGH>
            , <&gpio0 10 GPIO_ACTIVE_HIGH>
            ;

        row-gpios
            = <&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 0  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 30 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 31 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 2  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };

    kscan_rotary_switch: kscan_rotary_switch {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;
        toggle-mode;

        input-gpios
            = <&gpio1 10 GPIO_ACTIVE_LOW>
            , <&gpio0 03 GPIO_ACTIVE_LOW>
            , <&gpio0 28 GPIO_ACTIVE_LOW>
            ;
    };

    output_sol: output_sol {
        compatible = "zmk,output-generic";
        #binding-cells = <0>;
        control-gpios = <&gpio1 11 GPIO_ACTIVE_HIGH>;
    };

    // soft_off_wakers {
    //     compatible = "zmk,soft-off-wakeup-sources";
    //     wakeup-sources = <&kscan_rotary_switch>;
    // };
};